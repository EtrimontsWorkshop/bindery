{
  "name": "@bindery/core",
  "version": "0.1.0",
  "description": "Bindery core — PDF layout/quality analysis, zero Foundry dependency (A1)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json --emitDeclarationOnly",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:boundary": "npm run build && node scripts/check-boundary.mjs",
    "fixtures:verify": "tsx test/synth/verify-cli.ts"
  },
  "dependencies": {
    "pdfjs-dist": "6.4.299",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.12"
  }
}
