<div class="bindery-image-erase">
  <p class="hint bindery-image-erase-hint">{{localize "BINDERY.imageErase.hint"}}</p>

  <div class="bindery-image-erase-toolbar">
    <div class="bindery-image-erase-group">
      <label><input type="radio" name="tool" value="view" {{#if toolIsView}}checked{{/if}} /> {{localize "BINDERY.imageErase.toolView"}}</label>
      <label><input type="radio" name="tool" value="brush" {{#if toolIsBrush}}checked{{/if}} /> {{localize "BINDERY.imageErase.toolBrush"}}</label>
      <label><input type="radio" name="tool" value="rect" {{#if toolIsRect}}checked{{/if}} /> {{localize "BINDERY.imageErase.toolRect"}}</label>
      <label><input type="radio" name="tool" value="pick" {{#if toolIsPick}}checked{{/if}} /> {{localize "BINDERY.imageErase.toolPick"}}</label>
    </div>

    <div class="bindery-image-erase-group">
      <span>{{localize "BINDERY.imageErase.eraseTo"}}</span>
      <label><input type="radio" name="eraseTo" value="transparent" {{#if eraseToTransparent}}checked{{/if}} /> {{localize "BINDERY.imageErase.eraseTransparent"}}</label>
      <label><input type="radio" name="eraseTo" value="color" {{#if eraseToColor}}checked{{/if}} /> {{localize "BINDERY.imageErase.eraseColor"}}</label>
      <input type="color" name="color" value="{{color}}" />
    </div>

    <div class="bindery-image-erase-group">
      <label>{{localize "BINDERY.imageErase.brushSize"}}
        <input type="range" name="brushSize" min="2" max="{{brushMax}}" step="1" value="{{brushSize}}" />
      </label>
      <label>{{localize "BINDERY.imageErase.zoom"}}
        <input type="range" name="zoom" min="1" max="6" step="0.25" value="{{zoom}}" />
      </label>
    </div>

    <div class="bindery-image-erase-group">
      <button type="button" data-action="undo" {{#unless canUndo}}disabled{{/unless}}>{{localize "BINDERY.imageErase.undo"}}</button>
      <button type="button" data-action="reset">{{localize "BINDERY.imageErase.reset"}}</button>
    </div>
  </div>

  <div class="bindery-image-erase-viewport" data-viewport>
    <div class="bindery-image-erase-stage" data-stage></div>
  </div>

  <div class="bindery-image-erase-buttons">
    <button type="button" data-action="save">{{localize "BINDERY.imageErase.save"}}</button>
    <button type="button" data-action="cancel">{{localize "BINDERY.imageErase.cancel"}}</button>
  </div>
</div>
