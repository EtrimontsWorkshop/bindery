# A reference set for image classification, derived from real rulebooks (even as
# metadata/bbox only) — NEVER published in this repo.
test/reference/

# Images exported from samples/ by tools/calibrate-images.ts (a manual check) —
# derived from PDFs of third parties, never committed.
tools/.calibrate-images-review/

# Thumbnails in the reference set are crops of REAL PDF pages (never commit
# publisher content, not even as a fixture). test/reference/images-*.json (only
# metadata + user labels, zero pixels) IS committed as a lasting calibration
# artifact — only the thumbnails (and the HTML tool generated from them, which
# embeds them as base64) are excluded.
test/reference/thumbnails/
test/reference/label.html

# This repo directory is also the module folder of a local Foundry install.
# The entries below are build artifacts (packages/module/dist copied here by
# scripts/sync-local-module.mjs for local testing) — the source is packages/module/*.
/module.json
/scripts/
/styles/
/lang/
/templates/
/lib/
/module.zip

# The source zip of the fonts (unpacked, the needed files copied to
# packages/core/test/synth/assets/fonts/) — no need to keep it in the repo.
/Lato,Roboto.zip

# Throwaway exploration code (statblock and player-character export spikes):
# only its findings matter, so it stays out of the production code and history.
/spike/statblocks/
/spike/statblocks2/
/spike/bohaterowie/

# Outputs of local debugging scripts (dump-text.ts/save-one-png.ts): a full-resolution
